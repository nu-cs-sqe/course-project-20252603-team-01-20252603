@startuml

' ─────────────────────────────────────────
'  ENTRY POINT
' ─────────────────────────────────────────
package main {

  +class RiskGame {
    +main(args: String[]): void
  }
}

' ─────────────────────────────────────────
'  MODEL
' ─────────────────────────────────────────
package model {

  +class GameModel {
    -players: List<Player>
    -board: GameBoard
    -deck: Deck
    -currentPlayerIndex: int
    -gameState: GameState
    -setupManager: SetupManager
    -winner: Player
    -capturedTerritoryThisTurn: boolean

    +recordTerritoryCaptured(): void
    +awardEndOfTurnCard(player: Player): void
    +startGame(playerNames: List<String>, colors: List<PlayerColor>): boolean
    +claimTerritory(player: Player, territoryName: String): boolean
    +placeInitialArmies(player: Player, territoryName: String, count: int): boolean
    +finishSetup(): boolean
    +reinforceTerritory(player: Player, territoryName: String, count: int): boolean
    +fortifyTerritory(player: Player, fromName: String, toName: String, count: int): boolean
    +eliminatePlayer(loser: Player): void
    +checkWinCondition(): boolean
    +isGameOver(): boolean
    +getWinner(): Player
    +getCurrentPlayer(): Player
    +nextSetupPlayer(): Player
    +isSetupComplete(): boolean
    +getGameState(): GameState
    +advanceGameState(): void
  }

  +class SetupManager {
    ' Classic game: 3-6 players only
    +isValidPlayerCount(count: int): boolean
    +calculateStartingArmies(playerCount: int): int
    +areColorsUnique(colors: List<PlayerColor>): boolean
    +allTerritoriesClaimed(board: GameBoard): boolean
    +allPlayersPlacedArmies(players: List<Player>): boolean
  }

  +class Player {
    -name: String
    -color: PlayerColor
    -territories: List<Territory>
    -hand: List<RiskCard>
    -availableArmies: int
    -eliminated: boolean

    +addTerritory(territory: Territory): void
    +removeTerritory(territory: Territory): void
    +ownsTerritory(territory: Territory): boolean
    ' Place armies during reinforcement phase (start of turn)
    +reinforceTerritory(territory: Territory, count: int): boolean
    ' Move armies at end of turn (fortify phase)
    +fortify(from: Territory, to: Territory, count: int): boolean
    +hasAvailableArmies(): boolean
    +getAvailableArmies(): int
    +getTerritoryCount(): int
    +calculateReinforcements(board: GameBoard): int
    +addCard(card: RiskCard): void
    +tradeInCards(cards: List<RiskCard>): int
    +receiveCards(cards: List<RiskCard>): void
    +isEliminated(): boolean
    +mustTradeIn(): boolean
  }

  +class GameBoard {
    -continents: List<Continent>
    -territories: List<Territory>

    +initializeBoard(): void
    +getTerritoryByName(name: String): Territory
    +isTerritoryUnclaimed(name: String): boolean
    +claimTerritory(name: String, player: Player): boolean
    +allTerritoriesClaimed(): boolean
    +getUnclaimedTerritories(): List<Territory>
    +areAdjacent(t1: Territory, t2: Territory): boolean
    +getAdjacentEnemyTerritories(territory: Territory, player: Player): List<Territory>
  }

  +class Territory {
    -name: String
    -owner: Player
    -pieces: List<ArmyPiece>
    -continent: Continent
    -adjacentTerritories: List<Territory>

    +setOwner(player: Player): void
    +isOwnedBy(player: Player): boolean
    +isUnclaimed(): boolean
    ' Called during reinforcement or initial placement
    +placeArmies(pieces: List<ArmyPiece>): boolean
    ' Called during fortify phase (end of turn, single free move)
    +moveArmies(pieces: List<ArmyPiece>): List<ArmyPiece>
    ' Called to remove one army-worth of pieces after a battle casualty
    +loseArmy(): boolean
    ' Swap any piece(s) for equivalent total value; enforces no net change
    +swapPieces(remove: List<ArmyPiece>, add: List<ArmyPiece>): boolean
    ' Derived from summing piece values - not stored
    +getArmyCount(): int
    +getPieces(): List<ArmyPiece>
    +getName(): String
    +canAttackFrom(): boolean
  }

  +class Continent {
    -name: String
    -territories: List<Territory>
    -bonusArmies: int

    +containsTerritory(territory: Territory): boolean
    +isControlledBy(player: Player): boolean
    +getBonusArmies(): int
  }

  +class Deck {
    -cards: List<RiskCard>
    -discardPile: List<RiskCard>
    ' Global counter shared across all players; drives trade-in army escalation
    -globalTradeInCount: int

    +initializeClassicDeck(territories: List<Territory>): void
    +shuffle(): void
    +drawCard(): RiskCard
    +getNextTradeInValue(): int
    +incrementTradeInCount(): void
    +size(): int
    +isEmpty(): boolean
    +reshuffleDiscard(): void
  }

  +class RiskCard {
    -territory: Territory
    -type: CardType
    -wild: boolean

    +getType(): CardType
    +isWild(): boolean
    +matchesTerritory(territory: Territory): boolean
  }

  ' Encapsulates one dice-roll exchange between attacker and defender
  +class Battle {
    -attacker: Player
    -defender: Player
    -attackingTerritory: Territory
    -defendingTerritory: Territory
    -attackerDice: int
    -defenderDice: int
    -attackerRolls: List<Integer>
    -defenderRolls: List<Integer>

    +isValidAttack(): boolean
    +rollAttackerDice(): List<Integer>
    +rollDefenderDice(): List<Integer>
    +resolveRolls(): BattleResult
    +captureTerritory(): void
  }

  +class BattleResult {
    -attackerLosses: int
    -defenderLosses: int
    -territoryCapture: boolean

    +getAttackerLosses(): int
    +getDefenderLosses(): int
    +isCaptured(): boolean
  }

  +class ArmyPiece {
    -type: ArmyType
    ' Value in Infantry: INFANTRY=1, CAVALRY=5, ARTILLERY=10
    +getValue(): int
    +getType(): ArmyType
  }

  +enum ArmyType {
    INFANTRY
    CAVALRY
    ARTILLERY
  }

  +enum GameState {
    SETUP_CLAIM
    SETUP_PLACE
    REINFORCEMENT
    ATTACK
    FORTIFY
    GAME_OVER
  }

  +enum CardType {
    INFANTRY
    CAVALRY
    ARTILLERY
    WILD
  }

  +enum PlayerColor {
    RED
    BLUE
    GREEN
    YELLOW
    BLACK
    PURPLE
  }
}

' ─────────────────────────────────────────
'  VIEW
' ─────────────────────────────────────────
package view {

  +class ConsoleView {
    +displayWelcomeMessage(): void
    +displaySetupInstructions(): void
    +promptNumberOfPlayers(): int
    +promptPlayerName(playerNumber: int): String
    +promptPlayerColor(playerName: String): PlayerColor
    +promptTerritoryChoice(player: Player, territories: List<Territory>): String
    +promptArmyCount(player: Player, max: int): int
    +promptAttackDecision(player: Player): boolean
    +promptAttackTargets(player: Player): String[]
    +promptFortifyDecision(player: Player): boolean
    +promptCardTradeIn(player: Player): List<RiskCard>
    +displayBoard(board: GameBoard): void
    +displayPlayers(players: List<Player>): void
    +displayCurrentPlayer(player: Player): void
    +displayBattleResult(result: BattleResult): void
    +displayWinner(player: Player): void
    +displayError(message: String): void
    +displaySetupComplete(): void
  }
}

' ─────────────────────────────────────────
'  CONTROLLER
' ─────────────────────────────────────────
package controller {

  +class GameController {
    -model: GameModel
    -view: ConsoleView
    -setupController: SetupController
    -turnController: TurnController

    +run(): void
    +startGame(): void
    +routeInput(command: String): void
    +checkAndHandleWin(): boolean
  }

  +class SetupController {
    -model: GameModel
    -view: ConsoleView

    +runSetup(): void
    +collectPlayerInfo(): void
    +handleTerritoryClaiming(): void
    +handleInitialArmyPlacement(): void
    +completeSetup(): void
  }

  +class TurnController {
    -model: GameModel
    -view: ConsoleView

    +runTurn(player: Player): void
    +handleReinforcement(player: Player): void
    +handleCardTradeIn(player: Player): void
    +handleAttackPhase(player: Player): void
    +handleFortifyPhase(player: Player): void
    +executeBattle(attacker: Player, from: Territory, to: Territory, attackerDice: int, defenderDice: int): BattleResult
  }
}

' ─────────────────────────────────────────
'  HAS-A / HAS-MANY RELATIONSHIPS
' ─────────────────────────────────────────

RiskGame --> GameController

GameModel --> "*" Player
GameModel --> GameBoard
GameModel --> Deck
GameModel --> SetupManager
GameModel --> GameState

Player --> "*" Territory
Player --> "*" RiskCard
Player --> PlayerColor

GameBoard --> "*" Continent
GameBoard --> "*" Territory

Continent --> "*" Territory

Territory --> Player
Territory --> Continent
Territory --> "*" Territory
Territory --> "*" ArmyPiece

Deck --> "*" RiskCard

RiskCard --> Territory
RiskCard --> CardType

ArmyPiece --> ArmyType

Battle --> Player
Battle --> Territory
Battle --> BattleResult

GameController --> GameModel
GameController --> ConsoleView
GameController --> SetupController
GameController --> TurnController

SetupController --> GameModel
SetupController --> ConsoleView

TurnController --> GameModel
TurnController --> ConsoleView

' ─────────────────────────────────────────
'  DEPENDENCY RELATIONSHIPS
' ─────────────────────────────────────────

ConsoleView ..> GameBoard
ConsoleView ..> Player
ConsoleView ..> Territory
ConsoleView ..> PlayerColor
ConsoleView ..> BattleResult
ConsoleView ..> RiskCard

SetupManager ..> GameBoard
SetupManager ..> Player
SetupManager ..> PlayerColor

TurnController ..> Battle
TurnController ..> BattleResult

note top of GameModel
  Model: stores game state and performs
  classic Risk domain logic (3-6 players).
  Win condition: one player owns all 42 territories.
end note

note top of ConsoleView
  View: command-line interface.
  Displays text and collects input.
end note

note top of GameController
  Controller: starts the app and
  routes user input through turn phases.
end note

note top of TurnController
  Manages the 3-phase turn loop:
  1. Reinforcement  2. Attack  3. Fortify
end note

note bottom of Deck
  Classic deck: 42 territory cards + 2 wilds.
  globalTradeInCount is shared across all
  players and drives army escalation:
  set 1=4, 2=6, 3=8, 4=10, 5=12, 6=15,
  then +5 per set thereafter.
end note

note bottom of Battle
  Attacker rolls 1-3 red dice (must have
  army count > dice count in from-territory).
  Defender rolls 1-2 white dice. Ties go
  to defender. Max 2 attacker losses per roll.
end note

note right of ArmyPiece
  Value type owned by Territory.pieces.
  INFANTRY = 1 army
  CAVALRY  = 5 armies
  ARTILLERY = 10 armies
  Any pieces may be swapped for any
  other pieces of equal total value.
end note

note right of Territory
  pieces: List<ArmyPiece> is the source of truth.
  getArmyCount() derived by summing piece values.
  placeArmies: reinforcement/setup
  moveArmies:  fortify phase free move
  loseArmy:    combat casualty removal
  swapPieces:  exchange any pieces for
    equivalent total value (e.g. 5 Infantry
    for 1 Cavalry); no net army change.
end note

note right of GameState
  SETUP_CLAIM:  players claim territories
  SETUP_PLACE:  distribute remaining armies
  REINFORCEMENT: start-of-turn army placement
  ATTACK:        optional dice combat
  FORTIFY:       optional single free move
  GAME_OVER:     win condition met
end note

@enduml
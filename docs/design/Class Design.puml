@startuml

' ─────────────────────────────────────────
'  ENTRY POINT
' ─────────────────────────────────────────
package main {

  +class RiskGame {
    -gameController: GameController
    +main(args: String[]): void
  }
}

' ─────────────────────────────────────────
'  MODEL
' ─────────────────────────────────────────
package model {

  +class GameModel {
  ' required
  -continents: List<Continent>
  +GameModel()
  +setPlayerCount(count: int): boolean
    -playerCount: int
    ' addPlayer should also have the if else for checking starting armies
    +addPlayer(name: String, color: PlayerColor): Player
    -players: List<Player>
    +initializeContinentsAndTerritories(): void
    -currentPlayerIndex: int
    +setCurrentPlayerIndex(index: int): void
    +claimTerritoryDuringSetup(player: Player, territory: Territory): boolean
    +allTerritoriesInitiallyClaimed(): boolean
    ' placeArmies is the general purpose function we use to place armies on territory -- this will be called from place remaining armies during setup and during fortify in game phase
    +placeArmies(player: Player, territory: Territory, armies: HashMap<ArmyType, Integer>): boolean



  ' not required
    -board: GameBoard
    -deck: Deck
    -winner: Player
    -capturedTerritoryThisTurn: boolean
    +awardEndOfTurnCard(player: Player): void
    +startGame(playerNames: List<String>, colors: List<PlayerColor>): boolean
    +finishSetup(): boolean
    +reinforceTerritory(player: Player, territory: Territory, count: int): boolean
    +fortifyTerritory(player: Player, fromName: String, toName: String, count: int): boolean
    +eliminatePlayer(loser: Player): void
    +checkWinCondition(): Player
    +getCurrentPlayer(): Player
    +nextPlayer(): Player
    +isSetupComplete(): boolean
    +calculateStartingArmies(): int
    +showAvailableColors(): List<PlayerColor>
    +allPlayersHavePlacedInitialArmies(): boolean
    +applyBattleResult(result: BattleResult, attacker: Player, defender: Player,
                       from: Territory, to: Territory): void
  }

  +abstract class Player {
    -name: String
    -color: PlayerColor
    -territories: List<Territory>
    -hand: List<RiskCard>
    -availableArmies: HashMap<ArmyType, Integer>
    -eliminated: boolean

    +addTerritory(territory: Territory): void
    +removeTerritory(territory: Territory): void
    +ownsTerritory(territory: Territory): boolean
    ' Place armies during reinforcement phase (start of turn)
    +reinforceTerritory(territory: Territory, count: int): boolean
    ' Move armies at end of turn (fortify phase)
    +fortify(from: Territory, to: Territory, count: int): boolean
    +hasAvailableArmies(): boolean
    +getAvailableArmies(): int
    +getTerritoryCount(): int
    +calculateReinforcementsToReceiveAtTurnStart(board: GameBoard): int
    +tradeInCards(cards: List<RiskCard>): int
    +receiveCards(cards: List<RiskCard>): void
    +isEliminated(): boolean
    +mustTradeIn(): boolean
  }

  +class HumanPlayer {
  ' required
  +HumanPlayer(name: String, color: PlayerColor, startingInfantry: int)

  ' not required
    +addTerritory(territory: Territory): void
    +removeTerritory(territory: Territory): void
    +ownsTerritory(territory: Territory): boolean
    ' Place armies during reinforcement phase (start of turn)
    +reinforceTerritory(territory: Territory, count: int): boolean
    ' Move armies at end of turn (fortify phase)
    +fortify(from: Territory, to: Territory, count: int): boolean
    +hasAvailableArmies(): boolean
    +getAvailableArmies(): int
    +getTerritoryCount(): int
    +calculateReinforcementsToReceiveAtTurnStart(board: GameBoard): int
    +tradeInCards(cards: List<RiskCard>): int
    +receiveCards(cards: List<RiskCard>): void
    +isEliminated(): boolean
    +mustTradeIn(): boolean
  }

  +class NullPlayer {
      +addTerritory(territory: Territory): void
      +removeTerritory(territory: Territory): void
      +ownsTerritory(territory: Territory): boolean
      ' Place armies during reinforcement phase (start of turn)
      +reinforceTerritory(territory: Territory, count: int): boolean
      ' Move armies at end of turn (fortify phase)
      +fortify(from: Territory, to: Territory, count: int): boolean
      +hasAvailableArmies(): boolean
      +getAvailableArmies(): int
      +getTerritoryCount(): int
      +calculateReinforcementsToReceiveAtTurnStart(board: GameBoard): int
      +tradeInCards(cards: List<RiskCard>): int
      +receiveCards(cards: List<RiskCard>): void
      +isEliminated(): boolean
      +mustTradeIn(): boolean
    }

    Player <|-- HumanPlayer
    Player <|-- NullPlayer

 ' can delete full class -- not required
  +class GameBoard {
  ' required
    -continents: List<Continent>
    ' the game board constructor should create the territories and continents and store in hash map -- hard coded
    +GameBoard(): void


' not required
    -territories: List<Territory>
    +initializeBoard(): void
    +isTerritoryUnclaimed(name: String): boolean
    +claimTerritory(name: String, player: Player): boolean
    +allTerritoriesClaimed(): boolean
    +getUnclaimedTerritories(): List<Territory>
    +areAdjacent(t1: Territory, t2: Territory): boolean
    +getAdjacentEnemyTerritories(territory: Territory, player: Player): List<Territory>
  }

  +class Territory {
  ' required
    -adjacentTerritories: List<Territory>
    -name: String
    -continent: Continent

  ' not required
    -owner: Player
    -pieces: HashMap<ArmyType, Integer>

    +setOwner(player: Player): void
    +isOwnedBy(player: Player): boolean
    +isUnclaimed(): boolean
    ' Called during reinforcement or initial placement
    +placeArmies(pieces: List<ArmyType>): boolean
    ' Called during fortify phase (end of turn, single free move)
    +moveArmies(pieces: List<ArmyType>): boolean
    ' Called to remove one army-worth of pieces after a battle casualty
    +loseArmyInBattle(): boolean
    ' Swap any piece(s) for equivalent total value; enforces no net change
    +swapPiecesForEquivalentArmies(remove: List<ArmyType>, add: List<ArmyType>): boolean
    ' Derived from summing piece values - not stored
    +getArmyCount(): int
    +getPieces(): List<ArmyPiece>
    +getName(): String
    +canAttackFrom(): boolean
  }

  +class Continent {
    -name: String
    -territories: List<Territory>
    -bonusArmies: int

    +containsTerritory(territory: Territory): boolean
    +isControlledBy(player: Player): boolean
    +getBonusArmies(): int
  }

  +class Deck {
  ' required
  ' constructor must create the cards (hardcoded)
    +Deck()
    -cards: List<RiskCard>
    +shuffle(): void


  ' not required
    -discardPile: List<RiskCard>
    ' Global counter shared across all players; drives trade-in army escalation
    -globalTradeInCount: int

    +initializeClassicDeck(territories: List<Territory>): void
    +drawCard(): RiskCard
    +getNextTradeInValue(): int
    +incrementTradeInCount(): void
    +size(): int
    +isEmpty(): boolean
    +reshuffleDiscard(): void
  }

  +class RiskCard {
    -territory: Territory
    -type: CardType
    -wild: boolean

    +getType(): CardType
    +isWild(): boolean
    +matchesTerritory(territory: Territory): boolean
  }

  ' Encapsulates one dice-roll exchange between attacker and defender
  +class Battle {
    -attacker: Player
    -defender: Player
    -attackingTerritory: Territory
    -defendingTerritory: Territory
    -attackerNumberOfDice: int
    -defenderNumberOfDice: int
    -attackerDiceResults: List<Integer>
    -defenderDiceResults: List<Integer>

    +Battle(attacker: Player, defender: Player,attackingTerritory: Territory,
    defendingTerritory: Territory, attackerNumberOfDice: int, defenderNumberOfDice: int)
    +isValidAttack(): boolean
    +rollAllAttackerDice(): List<Integer>
    +rollAllDefenderDice(): List<Integer>
    +checkRollOutcomes(): BattleResult
    +captureTerritory(): void
  }

  +class BattleResult {
    -attackerLosses: int
    -defenderLosses: int
    -territoryCapture: boolean

    +getAttackerLosses(): int
    +getDefenderLosses(): int
    +isCaptured(): boolean
  }

  +class ArmyPiece {
    -type: ArmyType
    ' Value in Infantry: INFANTRY=1, CAVALRY=5, ARTILLERY=10
    +getValue(): int
    +getType(): ArmyType
  }

  +enum ArmyType {
    INFANTRY
    CAVALRY
    ARTILLERY
  }

  +enum CardType {
    INFANTRY
    CAVALRY
    ARTILLERY
    WILD
  }

  +enum PlayerColor {
    RED
    BLUE
    GREEN
    YELLOW
    BLACK
    PURPLE
  }
}

' ─────────────────────────────────────────
'  VIEW
' ─────────────────────────────────────────
package view {

  +class ConsoleView {
    ' required
    +displayWelcomeMessage(): void
    +getNumberOfPlayers(): int
    +getPlayerName(): String
    +getPlayerColor(availableColors: List<PlayerColor>): PlayerColor
    +displayRemainingTerritoriesAndGetTerritoryChoice(player: Player, continents: HashMap<Continent, Territory>): Territory

    ' not required

    +displayCurrentPlayer(player: Player): void
    +displaySetupInstructions(): void
    +getTerritoryChoice(player: Player, territories: List<Territory>): Territory
    +getArmyCount(player: Player, max: int): int
    +promptAttackDecision(player: Player): boolean
    +promptAttackTargets(player: Player): String[]
    +promptFortifyDecision(player: Player): boolean
    +promptCardTradeIn(player: Player): List<RiskCard>
    +displayBoard(board: GameBoard): void


    +displayBattleResult(result: BattleResult): void
